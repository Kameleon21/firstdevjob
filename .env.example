# Convex
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk (Next.js)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk (Convex auth provider)
CLERK_JWT_ISSUER_DOMAIN=https://your-issuer.clerk.accounts.dev

# Optional: feedback board URL shown at /feedback
NEXT_PUBLIC_FEEDBACK_BOARD_URL=https://your-board.fider.io

# Resend email notifications
RESEND_API_KEY=re_xxx
RESEND_TEST_MODE=true
EMAIL_FROM=hello@yourdomain.com
STAFF_NOTIFICATION_EMAILS=admin@yourdomain.com,moderator@yourdomain.com
EMAIL_REPLY_TO=you@yourdomain.com
NEXT_PUBLIC_SITE_URL=https://firstdevjob.com
