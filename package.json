{
  "name": "firstdevjob",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun next dev --turbopack",
    "build": "next build",
    "start": "bun --bun next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true next build",
    "lint:fix": "eslint . --fix",
    "type-check": "bun x tsc --noEmit --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "audit:deps": "bun audit --audit-level=high --ignore GHSA-w3rx-r6r6-pgpr --ignore GHSA-5p2g-fcmc-qvqq --ignore GHSA-qjx8-664m-686j",
    "postinstall": "fumadocs-mdx",
    "sync:prod-to-dev": "bunx convex export --prod --path prod-snapshot.zip && bunx convex import --replace prod-snapshot.zip; rm -f prod-snapshot.zip"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.37.1",
    "@convex-dev/resend": "^0.2.3",
    "@types/mdx": "^2.0.13",
    "convex": "^1.31.7",
    "fumadocs-core": "^16.5.0",
    "fumadocs-mdx": "^14.2.6",
    "fumadocs-ui": "^16.5.0",
    "lucide-react": "^0.513.0",
    "mermaid": "^12.0.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@jest/globals": "^30",
    "@next/bundle-analyzer": "^15.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30",
    "@types/node": "^20.19.30",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.11",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30",
    "jest-environment-jsdom": "^30",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
