{
  "name": "firstdevjob",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.30",
  "scripts": {
    "dev": "bun --bun next dev --turbopack",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint .",
    "analyze": "ANALYZE=true bun --bun next build",
    "lint:fix": "eslint . --fix",
    "type-check": "bun x tsc --noEmit --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@clerk/nextjs": "^6.37.1",
    "@convex-dev/auth": "^0.0.90",
    "@types/mdx": "^2.0.13",
    "convex": "^1.31.7",
    "fumadocs-core": "^16.5.0",
    "fumadocs-mdx": "^14.2.6",
    "fumadocs-ui": "^16.5.0",
    "lucide-react": "^0.513.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.3.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@jest/globals": "^30.2.0",
    "@next/bundle-analyzer": "^15.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.30",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.11",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
